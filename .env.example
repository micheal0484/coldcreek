# Copy to .env.local and fill in. All are read at build time (static export),
# so they must keep the NEXT_PUBLIC_ prefix and be set before `npm run build`.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY

# reCAPTCHA v2 (checkbox) SITE key - public. The SECRET key goes in the
# EmailJS dashboard (Account > Security), never in this file.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY
